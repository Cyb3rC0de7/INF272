@* Interface Enumarable = Enumarate or list (to ascertain the number of : count) *@

@model IEnumerable<qwintonStudyGroup.Models.studentModel>

@{
    ViewBag.Title = "List of Students";
}

<h2>List of Students</h2>

@*<p>
        @Html.ActionLink("Create New", "Create") >> In this overload it is the name and the action >> Link going nowhere.
    </p>*@
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.studentNumber)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.lastName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.email)
        </th>
        <th>Link</th>
        <th>Remove</th>
    </tr>

    @foreach (var item in Model) //For each student
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.studentNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.lastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.email)
            </td>
            <td>
                <a href="@Url.Content(item.myLink)" class="btn btn-primary">LINK</a>
            </td>
            <td>
                <button class="btn btn-danger remove-btn" onclick="remove(this)">Remove</button>
            </td>
        </tr>
    }

</table>

@section scripts{
    <script type="text/javascript">
        function remove(button) {
            $(button).closest('tr').fadeOut(300, function () {
                $(this).remove();
            })
        }

        $('table tr').each(function () {
            var nameCell = $(this).find('td:nth-child(2)'); // 2nd column = name
            if (nameCell.text().trim().startsWith('R')) {
                $(this).css('color', 'red');
            }
        });
    </script>
    }