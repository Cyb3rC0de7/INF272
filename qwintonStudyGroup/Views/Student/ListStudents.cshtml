@model IEnumerable<qwintonStudyGroup.Models.studentModel>

@{
    ViewBag.Title = "List of Students";
}

<h2>List of Students</h2>

<input type="text" id="searchBox" placeholder="Search for a student..." />
<button onclick="search()">Search</button>
<p>
    @Html.ActionLink("Create New Student", "CreateStudent", "Student", new { @class = "btn btn-primary" })
</p>

<table class="table" id="studentsTable">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().studentNumber)</th>
            <th>@Html.DisplayNameFor(model => model.First().name)</th>
            <th>@Html.DisplayNameFor(model => model.First().lastName)</th>
            <th>@Html.DisplayNameFor(model => model.First().email)</th>
            <th>Remove</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.studentNumber</td>
                <td>@item.name</td>
                <td>@item.lastName</td>
                <td>@item.email</td>
                <td><button class="btn btn-danger" onclick="removeRow(this)">Remove</button></td>
            </tr>
        }
    </tbody>
</table>

<button onclick="saveToLocalStorage()">Save</button>
<button onclick="loadFromLocalStorage()">Load</button>
<button onclick="clearStorage()">Clear</button>

@section scripts {
    <script>
        function removeRow(button) {
            $(button).closest('tr').fadeOut(300, function () {
                $(this).remove();
            });
        }

        function search() {
            let term = $('#searchBox').val().toLowerCase();

            $('#studentsTable tbody tr').each(function () {
                let rowText = $(this).text().toLowerCase();

                if (rowText.includes(term) && term !== "") {
                    $(this).css('color', 'red');
                    let row = this;
                    setTimeout(() => {
                        $(row).css('color', '');
                    }, 3000);
                }
            });
        }

        function saveToLocalStorage() {
            let students = [];

            $('#studentsTable tbody tr').each(function () {
                let tds = $(this).find('td');
                let student = {
                    studentNumber: tds.eq(0).text(),
                    name: tds.eq(1).text(),
                    lastName: tds.eq(2).text(),
                    email: tds.eq(3).text()
                };
                students.push(student);
            });

            localStorage.setItem("students", JSON.stringify(students));
            alert("Students saved to localStorage!");
        }

        function loadFromLocalStorage() {
            let stored = localStorage.getItem("students");
            if (!stored) {
                alert("No saved students found.");
                return;
            }

            let students = JSON.parse(stored);
            let tbody = $('#studentsTable tbody');
            tbody.empty();

            students.forEach(student => {
                tbody.append(`
                            <tr>
                                <td>${student.studentNumber}</td>
                                <td>${student.name}</td>
                                <td>${student.lastName}</td>
                                <td>${student.email}</td>
                                <td><button class="btn btn-danger" onclick="removeRow(this)">Remove</button></td>
                            </tr>
                        `);
            });
        }

        function clearStorage() {
            localStorage.removeItem("students");
            alert("localStorage cleared!");
        }
    </script>
}